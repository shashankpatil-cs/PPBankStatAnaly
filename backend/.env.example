# MongoDB
# Use mongodb://localhost:27017 for local host dev, or mongodb://mongo:27017 for Docker Compose
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=phonepe_analyzer

# Authentication (Generate secret with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AWS S3 (Optional - if blank, files are stored locally/in Mongo without S3 archival)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=phonepe-analyzer-bucket

# OpenAI (Optional - required for AI Assistant chat; rest of app works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server & Upload Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=/tmp/phonepe_uploads
